{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "masseffect-preview",
  "account_id": "dbb3e1e9f7696eb4d77dce586dd112df",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
  },
  "env": {
    "preview": {
      "name": "masseffect-preview",
      "workers_dev": true,
      "preview_urls": false,
    },
    "production": {
      "name": "masseffect",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "masseffect.bruni.to", "custom_domain": true }],
    },
  },
}
